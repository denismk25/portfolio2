---
import SectionHeading from "@/components/SectionHeading.astro";
import { credentials, person, toolkit } from "@/data/site";
---

<section id="toolkit" class="border-t border-line bg-surface">
  <div class="mx-auto max-w-6xl px-5 py-20 md:px-8 md:py-28">
    <SectionHeading index="04 — Stack" title="Toolkit" />

    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-4">
      {
        toolkit.map((group, i) => (
          <div data-reveal style={`--reveal-delay:${i * 70}ms`}>
            <p class="label border-b border-ink pb-3 text-muted">{group.group}</p>
            <ul class="mt-4 flex flex-wrap gap-2">
              {group.tools.map((tool) => (
                <li class="pressable border border-line bg-paper px-2.5 py-1.5 text-[0.8rem] font-medium transition-colors hover:border-ink">
                  {tool}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    {/* ---- Certifications & education ---- */}
    <div class="mt-20 border-t-2 border-ink pt-10" data-reveal>
      <h3 class="font-display text-2xl font-extrabold md:text-3xl">
        Certifications & education
      </h3>
      <ul class="mt-8 grid gap-px bg-line sm:grid-cols-3">
        {
          credentials.map((item) => (
            <li class="bg-paper p-6">
              <p class="label text-plot">{item.kind}</p>
              <p class="mt-3 font-display text-lg font-bold leading-snug">{item.name}</p>
              <p class="mt-2 text-sm text-muted">{item.issuer}</p>
            </li>
          ))
        }
      </ul>
      <p class="label mt-8 text-muted">Languages — {person.languages}</p>
    </div>
  </div>
</section>
