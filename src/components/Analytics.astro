---
import { analytics } from "@/data/site";

// Only in production builds, and only once an ID is set. `npm run dev` stays
// out of the data, and a blank ID emits nothing rather than a broken tag.
const clarityId = analytics.clarityProjectId;
const enabled = import.meta.env.PROD && Boolean(clarityId);
---

{
  enabled && (
    <Fragment>
      {/* Warm up the connection while the rest of the head parses */}
      <link rel="preconnect" href="https://www.clarity.ms" crossorigin />
      <link rel="dns-prefetch" href="https://www.clarity.ms" />

      {/* Microsoft Clarity — official snippet, injected async so it never
          blocks render or costs LCP */}
      <script
        is:inline
        type="text/javascript"
        set:html={`(function(c,l,a,r,i,t,y){
    c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
    t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
    y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
})(window, document, "clarity", "script", ${JSON.stringify(clarityId)});`}
      />
    </Fragment>
  )
}
