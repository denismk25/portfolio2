---
import { about, highlights } from "@/data/site";
---

<section id="about" class="border-y border-line bg-surface">
  <div class="mx-auto grid max-w-6xl gap-12 px-5 py-20 md:grid-cols-[1.15fr_0.85fr] md:px-8 md:py-28">
    <div data-reveal>
      <p class="label mb-6 text-muted">02 — About</p>
      <p class="font-display text-[clamp(1.6rem,3.6vw,2.5rem)] font-bold leading-[1.15]">
        {about.lead}
      </p>
      {
        about.body.map((para) => (
          <p class="mt-6 max-w-[62ch] text-lg leading-relaxed text-muted">{para}</p>
        ))
      }
    </div>

    <div class="self-start" data-reveal style="--reveal-delay:120ms">
      <div class="offset-block border border-ink bg-paper p-6 md:p-8">
        <p class="label border-b border-line pb-4 text-muted">By the numbers</p>
        <dl class="mt-2 divide-y divide-line">
          {
            highlights.map((item) => (
              <div class="flex items-baseline justify-between gap-5 py-4">
                <dt class="text-sm leading-snug text-muted">
                  {item.label}
                  <span class="mt-0.5 block font-mono text-[10px] uppercase tracking-wider text-muted/70">
                    {item.note}
                  </span>
                </dt>
                <dd class="numeral shrink-0 text-2xl font-extrabold">{item.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </div>
</section>
